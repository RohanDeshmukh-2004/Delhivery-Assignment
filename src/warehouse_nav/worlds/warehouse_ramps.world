<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_ramps_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="outer_walls">
      <static>true</static>
      <link name="link">
        <collision name="w1_c"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        <visual name="w1_v"><pose>0 10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></visual>
        <collision name="w2_c"><pose>0 -10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></collision>
        <visual name="w2_v"><pose>0 -10 1.5 0 0 0</pose><geometry><box><size>20 0.2 3</size></box></geometry></visual>
      </link>
    </model>

    <!-- Elevated Mezzanine -->
    <model name="mezzanine_level">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="deck_col"><geometry><box><size>6 8 1.0</size></box></geometry></collision>
        <visual name="deck_vis">
          <geometry><box><size>6 8 1.0</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Ramp (~12 degree slope) -->
    <model name="warehouse_ramp">
      <static>true</static>
      <pose>0.8 0 0.5 0 0.21 0</pose>
      <link name="link">
        <collision name="ramp_col">
          <geometry><box><size>4.8 2.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ramp_vis">
          <geometry><box><size>4.8 2.0 0.1</size></box></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Storage Racks -->
    <model name="storage_rack_1">
      <static>true</static>
      <pose>-4 3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="storage_rack_2">
      <static>true</static>
      <pose>-4 -3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 5.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 5.0 2.0</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>